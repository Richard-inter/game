namespace gachaMachine;

enum MessageType : byte {
  GetPullResultWsReq = 0,
  GetPullResultWsResp = 1,
  GetPlayerInfoWsReq = 2,
  GetPlayerInfoWsResp = 3,
  GetMachineInfoWsReq = 4,
  GetMachineInfoWsResp = 5,
  GetPlayerInventoryWsReq = 6,
  GetPlayerInventoryWsResp = 7,
  GetPlayerPullHistoryWsReq = 8,
  GetPlayerPullHistoryWsResp = 9,
  ErrorResp = 100
}

/***************
 * Requests
 ***************/
table GetPullResultWsReq {
  player_id:long;
  machine_id:long;
  pull_count:int;
}

table GetPlayerInfoWsReq {
  player_id:long;
}

table GetMachineInfoWsReq {
  machine_id:long;
}

table GetPlayerInventoryWsReq {
  player_id:long;
}

table GetPlayerPullHistoryWsReq {
  player_id:long;
}

/***************
 * Responses
 ***************/
table GetPullResultWsResp {
  item_ids:[long];
}

table GetPlayerInfoWsResp {
  player_id:long;
  username:string;
  coin:long;
  diamond:long;
  pity_state:[PityState];
}

table PityState {
  machine_id:long;
  super_rare_pity:int;
  ultra_rare_pity:int;
}

table Items {
  item_id:long;
  name:string;
  rarity:string;
  pull_weight:int;
}

table GetMachineInfoWsResp {
  machine_id:long;
  name:string;
  price:long;
  price_times_ten:long;
  super_rare_pity:int;
  ultra_rare_pity:int;
  items:[Items];
}

table PlayerInventoryItem {
  item_id:long;
  quantity:int;
}

table GetPlayerInventoryWsResp {
  player_id:long;
  items:[PlayerInventoryItem];
}

table PullHistoryItem {
  item_id:long;
}

table PullSession {
  session_id:long;
  machine_id:long;
  pull_count:int;
  items_pulled:[PullHistoryItem];
}

table GetPlayerPullHistoryWsResp {
  player_id:long;
  sessions:[PullSession];
}

/***************
 * Error
 ***************/
table ErrorResp {
  code:int;
  message:string;
}

/***************
 * Envelope
 ***************/
table Envelope {
  type:MessageType;
  payload:[ubyte];
}

root_type Envelope;
